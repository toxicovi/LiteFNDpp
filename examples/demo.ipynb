# LiteFND++ Demo

This notebook demonstrates how to use LiteFND++ for fake news detection, including model training, prediction, explanation, and auxiliary utilities.

```python
# Imports
from litefndpp.model import LiteFNDpp
from litefndpp.utils import LinguisticStyleAnalyzer, TemporalPatternDetector

# Sample data
texts = [
    "Breaking news! Scientists discovered a shocking cure for COVID.",
    "Local news reports a minor traffic accident downtown."
]
labels = [1, 0]  # 1 = Fake, 0 = Real

# Initialize model
model = LiteFNDpp()

# Train the model
model.fit(texts, labels)

# Predictions
predictions = model.predict(texts)
probabilities = model.predict_proba(texts)
print("Predictions:", predictions)
print("Probabilities:", probabilities)

# Explain predictions using LIME
explanation = model.explain(texts[0], num_features=5)
print("Top Features:", explanation["top_features"])
print("Cognitive Scores:", explanation["cognitive_scores"])
print("Predicted Class:", explanation["prediction"])

# Optional utilities
style_analyzer = LinguisticStyleAnalyzer()
style_scores = style_analyzer.analyze_style(texts[0])
print("Style Analysis:", style_scores)

temporal_detector = TemporalPatternDetector(time_window=3600)
temporal_detector.add_post("hash1", 1700000000)
temporal_detector.add_post("hash1", 1700000300)
coordination = temporal_detector.detect_coordination()
print("Coordination Detection:", coordination)

